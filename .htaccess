RewriteEngine On

# Redirect legacy .html URLs to clean URLs to avoid duplicate content
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html(?:\?.*)?\s [NC]
RewriteRule ^ /%1/ [R=301,L,NE]

# Normalize clean URLs for the core site pages
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(about|capabilities|towers|projects|contact)/?$ /$1/ [R=301,L]

# Preserve direct file serving for the original static files if needed
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^about/?$ /about/index.html [L]
RewriteRule ^capabilities/?$ /capabilities/index.html [L]
RewriteRule ^towers/?$ /towers/index.html [L]
RewriteRule ^projects/?$ /projects/index.html [L]
RewriteRule ^contact/?$ /contact/index.html [L]
